# NEXT_PUBLIC_SUPABASE_ANON_KEY: use the "publishable" key (sb_publishable_...)
# from Supabase → Settings → API Keys → Publishable key. Safe to expose to
# the browser — NOT the secret key (that stays backend-only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
